{
  "name": "career-chive",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in CareerChive for Next.js App Router. Install from GitHub.",
  "bin": {
    "career-chive": "./scripts/cli.mjs"
  },
  "files": [
    "package",
    "src",
    "public",
    "scripts/cli.mjs",
    "scripts/schema.sql",
    "scripts/chivebot.sql",
    ".env.example"
  ],
  "exports": {
    ".": "./package/index.ts",
    "./attachments": "./package/attachments.ts",
    "./config": "./package/config.ts",
    "./styles.css": "./package/styles.css"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
